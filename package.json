{
  "name": "terminal-runner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "preview:tui": "npm run build && node dist/scripts/preview-tui.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke:codex": "npm run build && node dist/scripts/smoke-codex.js",
    "smoke:claude": "npm run build && node dist/scripts/smoke-claude.js",
    "smoke:claude-input": "npm run build && node dist/scripts/smoke-claude-input.js",
    "check:design": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext contracts/agent.ts && node scripts/validate-design.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "ajv": "8.20.0",
    "string-width": "8.3.0"
  }
}
