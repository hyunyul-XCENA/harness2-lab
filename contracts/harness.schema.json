{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminal-runner:harness:v1",
  "title": "Immutable harness bundle manifest draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "parent", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "parent": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["instructions", "skills", "scripts"] },
          "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\:\\u0000-\\u001F]+$" }
        }
      }
    }
  }
}
